---
import { t, type Lang } from '../i18n/strings';
import { path, services } from '../data/work';
const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
// split the paragraph into words so it can fill in as you scroll; <mark> stays intact
const parts = s.aboutBig.split(/(<mark>.*?<\/mark>)/).flatMap((p) =>
  p.startsWith('<mark>') ? [p] : p.split(/\s+/).filter(Boolean).map((w) => `<span class="w">${w}</span>`));
const para = parts.map((p) => p.startsWith('<mark>') ? p.replace('<mark>', '<mark class="w">') : p).join(' ');
---
<section class="about in" id="about" aria-labelledby="abh">
  <div class="headrow" data-rise><h2 id="abh">{s.about}</h2><span>{s.trail}</span></div>
  <div class="ab">
    <p class="big" id="abBig" set:html={para} />
    <ol class="path">
      {path.map((p) => (
        <li class:list={[{ now: p.now }]} data-rise>
          <div><b>{p[lang][0]}</b><span>{p[lang][1]}</span></div>
          <span class="w">{p[lang][2]}</span>
        </li>
      ))}
    </ol>
  </div>
  <div class="svc">{services[lang].map((x) => <span data-pop>{x}</span>)}</div>
</section>
