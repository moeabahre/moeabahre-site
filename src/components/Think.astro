---
import { content, type Lang } from '../i18n/content';
/* page: render as the Expertise page (h1, room for the header, plus the three practices) */
interface Props { lang: Lang; page?: boolean }
const { lang, page = false } = Astro.props;
const c = content[lang];
const H = page ? 'h1' : 'h2';
---
<section class:list={['sec think', { first: page }]} id="expertise" aria-labelledby="th-h">
  <div class="sec-top dark-rule" data-rv><span>{c.think.label}</span><span class="mute">{c.think.note}</span></div>
  <div class="think-top">
    <H id="th-h" data-rv><span>{c.think.head[0]}</span><span class="g">{c.think.head[1]}</span></H>
    <p data-rv>{c.think.intro}</p>
  </div>
  <ol class="tensions">
    {c.think.tensions.map(([n, a, b, d], i) => {
      // each description is two sentences: the first belongs to the first truth, the second to the other
      const [da, ...rest] = d.split(/(?<=\.)\s+/);
      return (
        <li class="bl" style={`--pos:${c.think.pos[i]}`} data-rv>
          <span class="bl-n">{n}</span>
          <b class="bl-a">{a}</b>
          <b class="bl-b">{b}</b>
          <span class="bl-s" aria-hidden="true"><i class="bl-pt"><em>{c.think.balanceL}</em></i></span>
          <p class="bl-da">{da}</p>
          <p class="bl-db">{rest.join(' ')}</p>
        </li>
      );
    })}
  </ol>
  <div class="practice" data-rv><span>{c.think.practiceL}</span><p>{c.think.practice}</p><span>{c.think.mark}</span></div>
  {page && (
    <>
      <div class="think-idx caps-top" data-rv><span>{c.pages.expertise.capsLabel}</span><span>{c.pages.expertise.capsNote}</span></div>
      <ol class="caps">
        {c.about.pillars.map(([n, t, d]) => (
          <li data-rv><span>{n}</span><b>{t}</b><p>{d}</p></li>
        ))}
      </ol>
      <p class="caps-svc" data-rv>{c.cta.services}</p>
    </>
  )}
</section>
