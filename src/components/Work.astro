---
import { content, cases, type Lang, ARROW as arrow } from '../i18n/content';
/* page: render as the Work page (h1, room for the header) */
interface Props { lang: Lang; page?: boolean }
const { lang, page = false } = Astro.props;
const c = content[lang];
const H = page ? 'h1' : 'h2';
---
<section class:list={['sec work', { first: page }]} id="work" aria-labelledby="wk-h">
  <div class="sec-top" data-rv><span>{c.work.label}</span><span class="mute">{c.work.note}</span></div>
  <div class="work-top">
    <div>
      <H class="mast" id="wk-h" data-rv><span>{c.work.mast[0]}</span><span>{c.work.mast[1]}</span></H>
      <p class="work-intro" data-rv>{c.work.intro}</p>
    </div>
    <a class="case" href={`/${lang}/work/${cases[lang][0].slug}/`} data-rv>
      <span class="case-n" aria-hidden="true">{c.work.feature.n}</span>
      <h3 dir="ltr">{c.work.feature.title[0]}<br />{c.work.feature.title[1]}</h3>
      <p class="kick">{c.work.feature.kicker}</p>
      <p class="case-d">{c.work.feature.desc}</p>
      <div class="case-meta">
        <span><i>{c.work.feature.roleL}</i><b>{c.work.feature.role}</b></span>
        <span><i>{c.work.feature.focusL}</i><b>{c.work.feature.focus}</b></span>
      </div>
      <p class="case-y">{c.work.feature.years}</p>
    </a>
  </div>
  <div class="idx-top" data-rv>
    <span>{c.work.moreLabel}</span>
    {page ? <span class="mute">{c.work.moreCount}</span> : <a class="mute idx-all" href={`/${lang}/work/`}>{c.pages.work.all} <span class="ar-ico" set:html={arrow} /></a>}
  </div>
  <ul class="idx">
    {c.work.rows.map((r, i) => (
      <li class:list={['row', { alt: i % 2 === 1 }]} data-rv>
        <a href={`/${lang}/work/${cases[lang][i + 1].slug}/`}>
          <span class="row-n">{r.n}</span>
          <h3 class="row-t">{r.title[0]}<br />{r.title[1]}</h3>
          <span class="row-m"><i>{r.type}</i><span>{r.desc}</span></span>
          <span class="row-r"><i>{r.role}</i><b>{r.years}</b></span>
          <span class="row-go" set:html={arrow} />
        </a>
      </li>
    ))}
  </ul>
</section>
