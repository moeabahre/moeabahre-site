---
import { t, type Lang } from '../i18n/strings';
const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
const email = 'me@moeabahre.com';
const chars = lang === 'ar' ? [s.ctBig] : [...s.ctBig];
---
<section class="contact in" id="contact" aria-labelledby="ctt">
  <div class="lead"><p data-rise>{s.ctLead}</p></div>
  <h2 class="talk" id="ctt" aria-label={s.ctBig}>
    {chars.map((c) => <span class="ch" aria-hidden="true">{c === ' ' ? ' ' : c}</span>)}<span class="ch b" aria-hidden="true">.</span>
  </h2>
  <div class="ct-row">
    <a class="mail" id="mail" href={`mailto:${email}`}>{email}</a>
    <button class="pill" id="copy" type="button" data-copied={s.copied} data-email={email} data-cur><i class="sq"></i><span>{s.copy}</span></button>
    <a class="pill ghost" href="https://www.linkedin.com/in/moeabahre" target="_blank" rel="noopener" data-cur>LinkedIn</a>
    <a class="pill ghost" href="https://www.behance.net/moeabahre" target="_blank" rel="noopener" data-cur>Behance</a>
    <a class="pill ghost" href="https://instagram.com/moeabahre" target="_blank" rel="noopener" data-cur>Instagram</a>
  </div>
  <footer><span>© {new Date().getFullYear()} {s.name}</span><span>{s.foot}</span></footer>
</section>
