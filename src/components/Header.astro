---
import logo from '../assets/full-logo.svg?raw';
import { content, EMAIL, LINKEDIN, CV, ARROW as arrow, type Lang } from '../i18n/content';
/* page: the nav entry to mark as current ('' is home); path: this page under /{lang}/, for the language switch */
interface Props { lang: Lang; page?: string; path?: string }
const { lang, page = '', path = '' } = Astro.props;
const c = content[lang];
const other: Lang = lang === 'en' ? 'ar' : 'en';
---
<header class="hdr" id="hdr">
  <a class="hdr-brand" href={`/${lang}/`} aria-label="moe. home">
    <span class="logo" set:html={logo} />
    <span class="hdr-meta">{c.header.meta}</span>
  </a>
  <nav class="hdr-nav" id="nav" aria-label={lang === 'ar' ? 'الرئيسية' : 'Main'}>
    {c.header.nav.map(([label, href], i) => (
      <a href={`/${lang}/${href}`} class:list={['hdr-link', { on: page === href }]} aria-current={page === href ? 'page' : undefined}><i>{String(i + 1).padStart(2, '0')}</i><b>{label}</b></a>
    ))}
  </nav>
  <div class="hdr-status">
    <div class="hdr-loc"><b>{c.header.location}</b><a class="hdr-lang" href={`/${other}/${path}`} hreflang={other} lang={other}>{c.langSwitch}</a></div>
    <span class="hdr-av"><i class="dot"></i>{c.header.available}</span>
  </div>
  <a class="hdr-cv" href={CV} download>
    <span><i>{c.header.cvEyebrow}</i><b>{c.header.cv}</b></span>
    <span class="sq" set:html={arrow} />
  </a>
  <button class="hdr-menu" id="menuBtn" type="button" aria-controls="nav" aria-expanded="false" data-open={c.header.menu} data-close={c.header.close}>{c.header.menu}</button>
</header>

