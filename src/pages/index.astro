---
// Root: send Arabic browsers to /ar/, everyone else to /en/.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>moe.</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href="https://moeabahre.com/en/" />
  <script is:inline>
    var l = (navigator.languages || [navigator.language || '']).join(',');
    location.replace(/(^|,)ar/i.test(l) ? '/ar/' : '/en/');
  </script>
  <meta http-equiv="refresh" content="1; url=/en/" />
</head>
<body style="background:#F2F1EC"></body>
</html>
