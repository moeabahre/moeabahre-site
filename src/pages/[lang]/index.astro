---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import About from '../../components/About.astro';
import Work from '../../components/Work.astro';
import Think from '../../components/Think.astro';
import Cta from '../../components/Cta.astro';
import Footer from '../../components/Footer.astro';
import { content, langs, ARROW as arrow, type Lang } from '../../i18n/content';
export function getStaticPaths() { return langs.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const c = content[lang];
---
<Base lang={lang}>
  <a class="skip" href="#main">{lang === 'ar' ? 'انتقل للمحتوى' : 'Skip to content'}</a>
  <Header lang={lang} />

  <main id="main">
    <!-- 01 HERO -->
    <section class="hero" id="home" aria-label={c.hero.name}>
      <img class="hero-grid" src="/img/hero-grid.svg" alt="" aria-hidden="true" />
      <span class="hatch hatch-l" aria-hidden="true"></span>
      <span class="hatch hatch-r" aria-hidden="true"></span>
      <div class="hero-port" id="port"><img src="/img/portrait.webp" alt={c.hero.name} width="1218" height="1504" fetchpriority="high" /></div>
      <p class="hero-big" aria-hidden="true" dir="ltr" data-fit><span>{c.hero.big}</span></p>
      <h1 class="hero-name" data-in data-fit><span>{c.hero.name}</span></h1>
      <div class="hero-role" data-in>
        <p>{c.hero.role[0]}<br />{c.hero.role[1]}</p>
        <a class="cta-dark" href={`/${lang}/contact/`}><span><i>{c.hero.ctaEyebrow}</i><b>{c.hero.cta}</b></span><span class="sq" set:html={arrow} /></a>
      </div>
      <p class="hero-pitch" data-in>{c.hero.pitch}</p>
    </section>

    <!-- 02–05 a short version of each page, each one leads to its own page -->
    <About lang={lang} />
    <Work lang={lang} />
    <Think lang={lang} />
    <Cta lang={lang} />
  </main>

  <Footer lang={lang} />
  <script>import '../../scripts/main.ts';</script>
</Base>
